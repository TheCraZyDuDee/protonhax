#!/bin/bash

phd=${XDG_RUNTIME_DIR:-/run/user/$UID}/protonhax

usage() {
    echo "Usage:"
    echo "protonhax init <launch-command> [args...]"
    printf "\\tWrap a Steam game or a launcher command that invokes Proton\n"
    echo "protonhax ls"
    printf "\\tLists all currently running games\n"
    echo "protonhax run <appid> <cmd> [args...]"
    printf "\\tRuns <cmd> in the context of <appid> with Proton\n"
    echo "protonhax cmd <appid>"
    printf "\\tRuns cmd.exe in the context of <appid>\n"
    echo "protonhax exec <appid> <cmd> [args...]"
    printf "\\tRuns <cmd> in the context of <appid>\n"
}

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

c=$1
shift

if [[ "$c" == "init" ]]; then
    if [[ $# -lt 1 ]]; then
        echo "protonhax: init requires the launch command and its arguments." >&2
        usage
        exit 1
    fi

    compat_data_path=${STEAM_COMPAT_DATA_PATH:-}
    prefix=${WINEPREFIX:-}
    if [[ -n "$compat_data_path" ]]; then
        prefix="$compat_data_path/pfx"
    fi
    if [[ -z "$prefix" ]]; then
        echo "protonhax: no Proton prefix found (STEAM_COMPAT_DATA_PATH or WINEPREFIX is missing)." >&2
        exit 1
    fi

    # Steam provides SteamAppId. Heroic provides HEROIC_APP_NAME and usually
    # STEAM_COMPAT_DATA_PATH. Hash the prefix as a final fallback.
    game_id=${SteamAppId:-${HEROIC_APP_ID:-${HEROIC_GAME_ID:-${HEROIC_APP_NAME:-}}}}
    if [[ -z "$game_id" ]]; then
        game_id=$(printf '%s' "$prefix" | cksum | awk '{print "nonsteam-" $1}')
    fi
    game_id=${game_id//[^a-zA-Z0-9_.-]/_}

    proton_exe=""
    for arg in "$@"; do
        # Some launchers pass Proton as its own argv item.
        case "$arg" in
            */proton|*/proton-*)
                if [[ -x "$arg" && -f "$arg" ]]; then
                    proton_exe=$arg
                    break
                fi
                ;;
        esac

        # Heroic's wrapper can receive the outer launcher command, with the
        # Proton invocation embedded in the --wrapper string.
        candidate=$(printf '%s\\n' "$arg" | sed -n "s/.*'\\(.*\\/proton\\)'.*/\\1/p")
        if [[ -z "$candidate" ]]; then
            candidate=$(printf '%s\\n' "$arg" | sed -n 's/.*"\\(.*\\/proton\\)".*/\\1/p')
        fi
        if [[ -n "$candidate" && -x "$candidate" && -f "$candidate" ]]; then
            proton_exe=$candidate
            break
        fi
    done

    if [[ -z "$proton_exe" ]]; then
        echo "protonhax: could not locate Proton in the launch command." >&2
        echo "If using Heroic, set the game's wrapper command to 'protonhax' and wrapper arguments to 'init'." >&2
        echo "If this launcher does not expose a Proton path in its command, automatic detection may not be supported." >&2
        exit 1
    fi

    game_dir="$phd/$game_id"
    mkdir -p -- "$game_dir" || exit 1
    printf '%s' "$proton_exe" > "$game_dir/exe"
    printf '%s' "$prefix" > "$game_dir/pfx"
    SteamAppId=$game_id
    export SteamAppId
    declare -px > "$game_dir/env"

    cleanup() { rm -rf -- "$game_dir"; }
    trap cleanup EXIT

    "$@"
    ec=$?
    exit "$ec"
elif [[ "$c" == "ls" ]]; then
    if [[ -d "$phd" ]]; then
        ls -1 -- "$phd"
    fi
elif [[ "$c" == "run" ]] || [[ "$c" == "cmd" ]] || [[ "$c" == "exec" ]]; then
    if [[ $# -lt 1 ]]; then
        usage
        exit 1
    fi
    game_id=$1
    shift
    game_dir="$phd/$game_id"
    if [[ ! -d "$game_dir" ]]; then
        printf 'No app running with appid "%s"\\n' "$game_id"
        exit 2
    fi

    source "$game_dir/env"
    SteamAppId=$game_id
    export SteamAppId
    proton_exe=$(cat "$game_dir/exe")
    prefix=$(cat "$game_dir/pfx")

    if [[ "$c" == "run" ]]; then
        [[ $# -ge 1 ]] || { usage; exit 1; }
        exec "$proton_exe" run "$@"
    elif [[ "$c" == "cmd" ]]; then
        exec "$proton_exe" run "$prefix/drive_c/windows/system32/cmd.exe"
    else
        [[ $# -ge 1 ]] || { usage; exit 1; }
        exec "$@"
    fi
else
    printf 'Unknown command %s\\n' "$c"
    usage
    exit 1
fi
